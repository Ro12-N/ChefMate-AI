# Clerk (https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Strapi Cloud (server-only token — never prefix with NEXT_PUBLIC_)
NEXT_PUBLIC_STRAPI_URL=https://your-project.strapiapp.com
STRAPI_API_TOKEN=

# Arcjet (https://app.arcjet.com)
ARCJET_KEY=

# Google Gemini
GEMINI_API_KEY=

# Unsplash (optional — recipe images fall back if unset)
UNSPLASH_ACCESS_KEY=
